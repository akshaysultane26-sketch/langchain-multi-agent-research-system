    "from pydantic import BaseModel\n",
    "\n",
    "class DemoModel(BaseModel):\n",
    "    name: str\n",
    "    age: int\n",
    "\n",
    "test_data = DemoModel(name=\"Bappy\", age=25)\n",
    "print(\"Pydantic is working perfectly:\", test_data.model_dump())\n",
    "\n"
   ]
